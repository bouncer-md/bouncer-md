{
  "name": "@bouncer-md/resolver",
  "version": "0.1.0",
  "description": "Reference resolver for the bouncer-md portable guardrail specification",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests",
