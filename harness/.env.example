# LLM Provider — anthropic (default) or openai
BOUNCER_LLM_PROVIDER=anthropic

# Anthropic API key — required when BOUNCER_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# OpenAI API key — required when BOUNCER_LLM_PROVIDER=openai
OPENAI_API_KEY=

# OpenAI base URL — optional, for Azure OpenAI or compatible endpoints
OPENAI_BASE_URL=

# Model override — optional, defaults to provider's recommended model
BOUNCER_LLM_MODEL=

# Print full IR and audit records on every scenario — optional, default false
BOUNCER_HARNESS_VERBOSE=false
